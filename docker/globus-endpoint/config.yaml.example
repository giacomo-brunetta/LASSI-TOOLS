# Globus Compute Endpoint 4.x endpoint-level configuration.
#
# Copy this file to:
#   ~/.globus_compute/lassi-x/config.yaml
#
# Endpoint 4.x rejects an `engine` field here. Copy the neighboring
# user_config_template.yaml.j2.example to user_config_template.yaml.j2; that
# template owns the engine, provider, scheduler, and worker_init settings.

display_name: LASSI-X A100 endpoint
