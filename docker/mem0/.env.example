# Copy to .env in this directory; docker compose interpolates it automatically.

# Credential for the Mem0 server's fact-extraction LLM and embedder. This is
# the server's own model access, independent of the LASSI-X agent providers.
OPENAI_API_KEY=
# Or use another bundled provider (then override the model defaults below):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Host port the Mem0 REST API is published on (memory.host in the run config).
# MEM0_PORT=8888

# Local-only Postgres credentials.
# POSTGRES_PASSWORD=mem0-local

# Authentication. The default (AUTH_DISABLED=true) accepts unauthenticated
# requests — fine for a local stack. To require a key instead:
#   AUTH_DISABLED=false
#   ADMIN_API_KEY=<some-secret>
# and export the same value in the environment variable named by
# memory.api_key_env in your LASSI-X run config.
# AUTH_DISABLED=true
# ADMIN_API_KEY=

# Anonymous telemetry from the Mem0 server (off by default here).
# MEM0_TELEMETRY=false
